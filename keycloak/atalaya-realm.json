{
  "realm": "atalaya",
  "enabled": true,
  "displayName": "Atalaya",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      { "name": "viewer", "description": "Read incidents, timelines, postmortems and game days" },
      { "name": "operator", "description": "Viewer, plus act on incidents: acknowledge, resend deliveries, change flags" }
    ]
  },
  "clients": [
    {
      "clientId": "atalaya-console",
      "name": "Atalaya Console",
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "atalaya-console-local-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": ["http://localhost:3100/auth/callback"],
      "webOrigins": ["http://localhost:3100"],
      "attributes": { "pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "http://localhost:3100/*" },
      "protocolMappers": [
        {
          "name": "realm roles in the ID token",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "roles", "multivalued": "true", "jsonType.label": "String", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true" }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "olivia", "firstName": "Olivia", "lastName": "Operator", "email": "olivia@atalaya.local", "emailVerified": true, "enabled": true,
      "credentials": [{ "type": "password", "value": "operator", "temporary": false }],
      "realmRoles": ["viewer", "operator"]
    },
    {
      "username": "victor", "firstName": "Victor", "lastName": "Viewer", "email": "victor@atalaya.local", "emailVerified": true, "enabled": true,
      "credentials": [{ "type": "password", "value": "viewer", "temporary": false }],
      "realmRoles": ["viewer"]
    }
  ]
}
